#!/usr/bin/env bash
set -u
ORCH_HOME="$HOME/.claude/orch"
: "${ORCH_QUEUE:=$ORCH_HOME/queue}"
: "${ORCH_PIDFILE:=$ORCH_HOME/daemon.pid}"
. "$ORCH_HOME/lib/task.sh"

usage() { cat <<'EOF'
orch add [dir] <prompt>            queue a task (dir defaults to cwd)
orch pipe <dir> <step...>          queue a pipeline task
orch add --each <dir...> <prompt>  fan-out (one task per dir)
orch ls                            list tasks
orch rm <id>                       remove a task (+ kill its session)
orch clean                         remove all done tasks (+ kill any leftover session)
orch start [--max N]               start daemon (default 3)
orch stop                          stop daemon
orch logs <id>                     dump the session's pane
Flags: --safe  (this task asks permission instead of skipping)
EOF
}

cmd="${1:-}"; shift || true
# collect --safe anywhere in args; strip it out
SAFE=false; _args=()
for a in "$@"; do [ "$a" = "--safe" ] && SAFE=true || _args+=("$a"); done
set -- "${_args[@]:-}"
_apply_safe() { [ "$SAFE" = true ] && task_set "$1" skip_perms false; }
_valid_max() { case "$1" in ''|*[!0-9]*) return 1;; *) [ "$1" -ge 1 ];; esac; }
case "$cmd" in
  add)
    if [ "${1:-}" = "--each" ]; then
      shift
      dirs=(); while [ $# -gt 1 ]; do dirs+=("$1"); shift; done
      prompt="$1"
      for d in "${dirs[@]}"; do
        id=$(task_create "$d" single "$prompt"); _apply_safe "$id"; echo "$id"
      done
    else
      [ -n "${1:-}" ] || { echo "usage: orch add [dir] <prompt>" >&2; exit 1; }
      dir="$1"; prompt="${2:-}"
      # one arg → it's the prompt; target the current directory
      [ -n "$prompt" ] || { prompt="$dir"; dir="$PWD"; }
      id=$(task_create "$dir" single "$prompt"); _apply_safe "$id"; echo "$id"
    fi ;;
  pipe)
    dir="$1"; shift
    id=$(task_create "$dir" pipeline "$@"); _apply_safe "$id"; echo "$id" ;;
  ls)
    printf '%-16s %-10s %-9s %-7s %s\n' ID TARGET MODE STEP STATUS
    for f in "$ORCH_QUEUE"/task-*.json; do
      [ -e "$f" ] || continue
      jq -r '"\(.id)\t\(.target|split("/")|last)\t\(.mode)\t\(.cursor+1)/\(.steps|length)\t\(.status)"' "$f" \
        | while IFS=$'\t' read -r id t m s st; do
            printf '%-16s %-10s %-9s %-7s %s\n' "$id" "$t" "$m" "$s" "$st"; done
    done ;;
  rm)
    # Kill the worker session before dropping the json — same reason `clean` does it.
    # Without this the pane outlives its task file, and re-dispatching the same id
    # then lands on spawn_session's `-N` suffix path: two live sessions on one
    # worktree, both tagged @orch_task=<id>, only one reachable from the queue.
    [ -n "${1:-}" ] || { echo "usage: orch rm <id>" >&2; exit 1; }
    f="$ORCH_QUEUE/task-$1.json"
    sess=""
    [ -e "$f" ] && sess=$(jq -r '.session // empty' "$f")
    [ -n "$sess" ] && ${ORCH_TMUX:-tmux} kill-session -t "$sess" 2>/dev/null
    rm -f "$f" ;;
  clean)
    # Drop finished tasks (status done). Kill any lingering worker session first —
    # normally already gone, but defensive so clean never orphans a tmux session.
    removed=0
    for f in "$ORCH_QUEUE"/task-*.json; do
      [ -e "$f" ] || continue
      [ "$(jq -r .status "$f")" = "done" ] || continue
      sess=$(jq -r '.session // empty' "$f")
      [ -n "$sess" ] && ${ORCH_TMUX:-tmux} kill-session -t "$sess" 2>/dev/null
      rm -f "$f"; removed=$((removed+1))
    done
    echo "cleaned $removed done task(s)" ;;
  start)
    # Validate args BEFORE any side-effect check so a bad --max is rejected the
    # same whether or not a daemon is already up.
    max=3
    if [ "${1:-}" = "--max" ]; then
      max="${2:-}"
      _valid_max "$max" || { echo "invalid --max: '${max}' (need positive integer)" >&2; exit 1; }
    fi
    # Refuse if ANY daemon is alive, not just the one in the pidfile. A stale/lost
    # pidfile let restarts stack multiple daemons that then raced — duplicate spawns
    # and concurrent task_set (jq->tmp->mv) corrupting queue jsons to 0 bytes.
    existing=$(pgrep -f "$ORCH_HOME/daemon.sh" | head -1)
    if [ -n "$existing" ]; then
      echo "daemon already running (pid $existing) — 'orch stop' first" >&2; exit 1
    fi
    ORCH_MAX="$max" nohup bash "$ORCH_HOME/daemon.sh" \
      >>"$ORCH_HOME/daemon.log" 2>&1 &
    echo $! > "$ORCH_PIDFILE"
    echo "daemon started (pid $(cat "$ORCH_PIDFILE"), max $max)" ;;
  stop)
    # Kill EVERY daemon process, not just the pidfile's — orphans from a lost
    # pidfile must not survive a stop (that's what stacked the racing daemons).
    pkill -f "$ORCH_HOME/daemon.sh" 2>/dev/null
    rm -f "$ORCH_PIDFILE"; echo "daemon stopped" ;;
  logs)
    sess=$(task_get "$1" session)
    if [ -z "$sess" ] || [ "$sess" = "null" ]; then
      echo "task $1 not started yet (no session)" >&2; exit 1
    fi
    ${ORCH_TMUX:-tmux} capture-pane -pt "$sess" ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown: $cmd" >&2; usage; exit 1 ;;
esac
